{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oims.collective-osp.org/schemas/agent-manifest-v1.json",
  "title": "OIMS CollectiveOS role-binding manifest",
  "type": "object",
  "required": [
    "schema_version",
    "family",
    "activation_semantics",
    "autonomous_worker_claim",
    "governance_route",
    "default_agent",
    "profiles"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "family": {"type": "string", "minLength": 1},
    "activation_semantics": {"const": "role_binding_only"},
    "autonomous_worker_claim": {"const": false},
    "governance_route": {
      "type": "array",
      "prefixItems": [
        {"const": "QC"},
        {"const": "GATA"},
        {"const": "GATA_PRIME"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "default_agent": {"type": "string", "minLength": 1},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "aliases",
          "tier",
          "purpose",
          "system_prompt"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "display_name": {"type": "string", "minLength": 1},
          "aliases": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "tier": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "system_prompt": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
