{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oims.collective-osp.org/schemas/tier-conformance-v3.json",
  "title": "OIMS tier conformance record",
  "type": "object",
  "required": [
    "@context",
    "@type",
    "schema_version",
    "family",
    "model",
    "provider",
    "architecture_family",
    "prompt_sha256",
    "contract_hash",
    "weight_source",
    "preflight",
    "invariant_vector",
    "status",
    "lawful",
    "weight_execution_verified",
    "backend",
    "record_sha256"
  ],
  "properties": {
    "@type": {"const": "OIMSModelTierConformanceRecord"},
    "schema_version": {"const": 3},
    "family": {"type": "string"},
    "model": {"type": "string"},
    "provider": {"type": "string"},
    "architecture_family": {"type": "string"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "weight_source": {"type": "object"},
    "preflight": {"type": "object"},
    "invariant_vector": {"type": "object"},
    "status": {"type": "string"},
    "lawful": {"type": "boolean"},
    "weight_execution_verified": {"type": "boolean"},
    "backend": {"type": "object"},
    "agent_binding": {"type": "object"},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
