{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oims.collective-osp.org/schemas/model-forge-run-receipt-1.1.0.json",
  "title": "OIMS Model Forge Simulation Receipt",
  "type": "object",
  "required": [
    "@context",
    "@type",
    "schema_version",
    "run_id",
    "plan_id",
    "plan_hash",
    "mode",
    "status",
    "evidence_class",
    "synthetic",
    "qmf_admissible",
    "deployable_artifact",
    "authority",
    "started_at",
    "completed_at",
    "steps",
    "input_tokens",
    "output_bytes",
    "duration_seconds",
    "peak_host_bytes",
    "peak_device_bytes",
    "energy_wh",
    "cost_microusd",
    "max_temperature_millic",
    "network_mode",
    "swap_used",
    "telemetry_file",
    "telemetry_hash",
    "checkpoint_directory",
    "checkpoint_count",
    "checkpoint_chain_head",
    "candidate_file",
    "candidate_hash",
    "rollback_artifact_hash",
    "governance_route",
    "limitations",
    "constraint_signals",
    "proof_vault",
    "source_commit",
    "source_tree",
    "record_sha256"
  ],
  "properties": {
    "@context": {"const": "https://oims.collective-osp.org/model-forge/v1"},
    "@type": {"const": "OIMSModelForgeRunReceipt"},
    "schema_version": {"const": "1.1.0"},
    "run_id": {"type": "string", "pattern": "^sim-[0-9a-f]{16}$"},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_hash": {"$ref": "#/$defs/digest"},
    "mode": {"const": "simulate"},
    "status": {"const": "COMPLETED"},
    "evidence_class": {"const": "SIMULATED"},
    "synthetic": {"const": true},
    "qmf_admissible": {"const": false},
    "deployable_artifact": {"const": false},
    "authority": {"const": "none"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "steps": {"type": "integer", "minimum": 1},
    "input_tokens": {"type": "integer", "minimum": 1},
    "output_bytes": {"type": "integer", "minimum": 1},
    "duration_seconds": {"type": "integer", "minimum": 1},
    "peak_host_bytes": {"type": "integer", "minimum": 1},
    "peak_device_bytes": {"type": "integer", "minimum": 1},
    "energy_wh": {"type": "integer", "minimum": 1},
    "cost_microusd": {"const": 0},
    "max_temperature_millic": {"type": "integer", "minimum": 1, "maximum": 95000},
    "network_mode": {"const": "none"},
    "swap_used": {"const": false},
    "telemetry_file": {"const": "telemetry.jsonl"},
    "telemetry_hash": {"$ref": "#/$defs/digest"},
    "checkpoint_directory": {"const": "checkpoints"},
    "checkpoint_count": {"type": "integer", "minimum": 1},
    "checkpoint_chain_head": {"$ref": "#/$defs/digest"},
    "candidate_file": {"const": "candidate/synthetic-candidate.json"},
    "candidate_hash": {"$ref": "#/$defs/digest"},
    "rollback_artifact_hash": {"$ref": "#/$defs/digest"},
    "governance_route": {"const": ["QC", "GATA", "GATA_PRIME"]},
    "limitations": {
      "const": [
        "no weights were loaded or modified",
        "no optimizer or gradient step executed",
        "resource observations are deterministic fixtures",
        "this receipt cannot satisfy a QMF model-training-run contract"
      ]
    },
    "constraint_signals": {
      "allOf": [
        {
          "$ref": "https://oims.collective-osp.org/schemas/model-forge-constraint-signals-1.0.0.json"
        },
        {"items": {"properties": {"satisfied": {"const": true}}}}
      ]
    },
    "proof_vault": {
      "allOf": [
        {
          "$ref": "https://oims.collective-osp.org/schemas/model-forge-proof-vault-metadata-1.0.0.json"
        },
        {"properties": {"record_class": {"const": "SIMULATION_RECEIPT"}}}
      ]
    },
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false,
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
