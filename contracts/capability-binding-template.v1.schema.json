{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "collective.capability-binding-templates.v1",
  "title": "CollectiveOS Capability Binding Templates v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "templates"],
  "properties": {
    "schema": {"const": "collective.capability-binding-templates.v1"},
    "status": {"const": "DECLARATIVE_NON_AUTHORIZING"},
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding_id",
          "procedure_ids",
          "actuator_ids",
          "verifier_ids",
          "input_artifact",
          "output_artifact",
          "output_authority",
          "locality",
          "cost_class"
        ],
        "properties": {
          "binding_id": {"type": "string", "minLength": 1},
          "procedure_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "actuator_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "verifier_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "input_artifact": {"type": "string", "minLength": 1},
          "output_artifact": {"type": "string", "minLength": 1},
          "output_authority": {"enum": ["proposal", "candidate", "evidence"]},
          "locality": {"enum": ["local", "remote", "hybrid"]},
          "cost_class": {"enum": ["free", "metered", "unknown"]}
        }
      }
    }
  }
}
